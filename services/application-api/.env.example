SPRING_DATASOURCE_URL=application_api_db_url
SPRING_DATASOURCE_USERNAME=application_api_db_username
SPRING_DATASOURCE_PASSWORD=application_api_db_password

SERVER_PORT=application_api_port

KAFKA_BOOTSTRAP_SERVERS=kafka_bootstrap_server
CONSUMER_GROUP_ID=consumer_group_id

# Google OAuth client IDs, comma-separated. Never put a Google client secret here.
GOOGLE_CLIENT_IDS=
REGISTRATION_ALLOWED_ORIGINS=http://localhost:8082
AUTH_ALLOWED_ORIGINS=http://localhost:8082

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the generated value in your local .env only; changing it invalidates access JWTs.
JWT_SIGNING_SECRET=
JWT_ISSUER=walkaround
JWT_AUDIENCE=walkaround-api
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# false is only for local HTTP development. Use true with HTTPS in deployed environments.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=walkaround_refresh

CITY_PROVIDER=geonames
GEONAMES_USERNAME=username
CITY_AUTOCOMPLETE_MAX_RESULTS=10
GEONAMES_BASE_URL=https://secure.geonames.org
GEONAMES_TIMEOUT=PT3S

