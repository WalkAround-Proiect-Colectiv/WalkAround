{
  "version": 8,
  "name": "WalkAround Romania",
  "glyphs": "/font/{fontstack}/{range}",
  "sources": {
    "basemap": {
      "type": "vector",
      "tiles": ["/tiles/basemap/{z}/{x}/{y}"],
      "minzoom": 4,
      "maxzoom": 15,
      "bounds": [19.5, 43.4, 30, 48.5],
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#f5f6f7"}},
    {"id": "landcover", "type": "fill", "source": "basemap", "source-layer": "features", "filter": ["==", ["get", "kind"], "landcover"], "paint": {"fill-color": ["match", ["get", "class"], ["forest", "wood"], "#c7dfc2", ["residential", "industrial", "commercial"], "#eef0f3", "#e0ebd7"]}},
    {"id": "water", "type": "fill", "source": "basemap", "source-layer": "features", "filter": ["==", ["get", "kind"], "water"], "paint": {"fill-color": "#a8d7f0"}},
    {"id": "waterway", "type": "line", "source": "basemap", "source-layer": "features", "filter": ["match", ["get", "kind"], ["waterway", "coastline"], true, false], "paint": {"line-color": "#8ec5e5", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 16, 3]}},
    {"id": "building", "type": "fill", "source": "basemap", "source-layer": "features", "minzoom": 13, "filter": ["==", ["get", "kind"], "building"], "paint": {"fill-color": "#dce0e5", "fill-outline-color": "#c5cbd3"}},
    {"id": "road-casing", "type": "line", "source": "basemap", "source-layer": "features", "filter": ["==", ["get", "kind"], "road"], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#c5cbd3", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 1.5, 12, 3, 18, 12]}},
    {"id": "road", "type": "line", "source": "basemap", "source-layer": "features", "filter": ["==", ["get", "kind"], "road"], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.6, 12, 2, 18, 10]}},
    {"id": "boundary", "type": "line", "source": "basemap", "source-layer": "features", "filter": ["==", ["get", "kind"], "boundary"], "paint": {"line-color": "#838b96", "line-dasharray": [3, 2], "line-width": 1}},
    {"id": "road-label", "type": "symbol", "source": "basemap", "source-layer": "features", "minzoom": 13, "filter": ["all", ["==", ["get", "kind"], "road"], ["has", "name"]], "layout": {"symbol-placement": "line", "text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 12}, "paint": {"text-color": "#545d68", "text-halo-color": "#ffffff", "text-halo-width": 1}},
    {"id": "place-label", "type": "symbol", "source": "basemap", "source-layer": "features", "filter": ["==", ["get", "kind"], "place"], "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 12, 12, 19], "text-max-width": 9, "text-padding": 12, "symbol-sort-key": ["match", ["get", "class"], "country", 0, "city", 1, "town", 2, 3]}, "paint": {"text-color": "#363d47", "text-halo-color": "#ffffff", "text-halo-width": 1.5}},
    {"id": "poi-dot", "type": "circle", "source": "basemap", "source-layer": "features", "minzoom": 15, "filter": ["==", ["get", "kind"], "poi"], "paint": {"circle-color": "#0065EB", "circle-radius": 3, "circle-stroke-color": "#ffffff", "circle-stroke-width": 1}},
    {"id": "poi-label", "type": "symbol", "source": "basemap", "source-layer": "features", "minzoom": 15, "filter": ["==", ["get", "kind"], "poi"], "layout": {"text-field": ["get", "name"], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-anchor": "top", "text-offset": [0, 0.6], "text-max-width": 8}, "paint": {"text-color": "#0065EB", "text-halo-color": "#ffffff", "text-halo-width": 1}}
  ]
}