MAP_DB_ADMIN_PASSWORD=replace_with_random_admin_password
MAP_IMPORT_PASSWORD=replace_with_random_import_password
MAP_TILES_PASSWORD=replace_with_random_url_safe_readonly_password
MAP_BIND_ADDRESS=127.0.0.1
MAP_DB_HOST_PORT=5435
MAP_VOLUME_PREFIX=walkaround-map
MAP_TILES_PORT=3001
OSM_EXTRACT_URL=https://download.geofabrik.de/europe/romania-latest.osm.pbf
OSM_REPLICATION_URL=https://download.geofabrik.de/europe/romania-updates
OSM_CACHE_MB=512
OSM_PROCESSES=2

MAP_DB_MEMORY_LIMIT=3g
MAP_DB_CPU_LIMIT=3.0
MAP_JOB_MEMORY_LIMIT=3g
MAP_JOB_CPU_LIMIT=2.0
MAP_SCHEMA_MEMORY_LIMIT=128m
MAP_SCHEMA_CPU_LIMIT=0.5
MAP_MIGRATE_MEMORY_LIMIT=768m
MAP_MIGRATE_CPU_LIMIT=1.0
MARTIN_MEMORY_LIMIT=512m
MARTIN_CPU_LIMIT=1.0
MAP_GATEWAY_MEMORY_LIMIT=128m
