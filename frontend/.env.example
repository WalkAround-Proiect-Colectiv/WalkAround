# Use your computer's LAN IP instead of localhost when testing on a physical phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# Public OAuth client ID of type Web application, also used as the mobile server client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Needed for native iOS sign-in; leave empty when testing in a browser.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Set after importing and starting services/map-data; leave empty for hosted prototype tiles.
# On a physical phone, use your computer's LAN IP and configure MAP_BIND_ADDRESS accordingly.
EXPO_PUBLIC_MAP_STYLE_URL=

# Native application identifiers must match the Google Cloud OAuth clients.
ANDROID_APPLICATION_ID=com.walkaround.app
IOS_BUNDLE_IDENTIFIER=com.walkaround.app
